[Unit]
Description=TERA field inbox worker
After=network-online.target build-api.service

[Service]
User=build
WorkingDirectory=/opt/build
EnvironmentFile=/etc/build/worker.env
ExecStart=/usr/bin/node --experimental-strip-types server/worker.ts
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=multi-user.target
