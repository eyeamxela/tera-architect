# Local test mode only. Copy to .env.local; never commit the filled file.
BUILD_MODE=local
BUILD_APP_ORIGIN=http://localhost:3010
BUILD_API_PORT=4312
# BUILD_DATA_DIR=.build-local

# Production API (remove local mode; use an external /etc/build/api.env on host)
# BUILD_MODE=production
# BUILD_APP_ORIGIN=https://your-build-domain.example
# DATABASE_URL=postgresql://...
# BUILD_ORGANIZATION_ID=generate-a-uuid
# BUILD_SHARE_SECRET=generate-32-or-more-random-characters
# BUILD_WORKER_SECRET=generate-32-or-more-random-characters
# BUILD_PROXY_SECRET=generate-32-or-more-random-characters
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_PUBLISHABLE_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
# BUILD_STORAGE_BUCKET=build-files
# BUILD_OWNER_EMAIL=
# BUILD_OWNER_NAME=
# BUILD_STUDIO_NAME=

# Optional worker and Telegram (dedicated bot and Hermes profile)
# BUILD_API_ORIGIN=http://127.0.0.1:4312
# HERMES_API_ORIGIN=http://127.0.0.1:8642
# HERMES_API_KEY=
# TELEGRAM_BOT_ID=
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_WEBHOOK_SECRET=
# BUILD_SEND_TELEGRAM_REPLIES=false
# TRANSCRIPTION_URL=
# TRANSCRIPTION_API_KEY=
# TRANSCRIPTION_MODEL=

# Cloudflare Worker runtime secrets are separate from this Node env file:
# BUILD_API_ORIGIN=https://api.your-domain.example
# BUILD_PROXY_SECRET=(same as API)
# GOOGLE_MAPS_EMBED_API_KEY=(optional, restricted to your origin)
